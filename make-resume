#!/bin/bash
# Build a resume: md -> docx (ATS upload) -> pdf (human copy),
# then show the extracted text layer, page count, and spelling report.
#
# Usage: ./make-resume [resume.md]   (defaults to resume_consolidated.md)
set -e
REPO="$(dirname "$(realpath "$0")")"
SRC="$(realpath "${1:-$REPO/resume_consolidated.md}")"
DIR="$(dirname "$SRC")"
BASE="$(basename "$SRC" .md)"
cd "$DIR"

echo "==> docx"
python3 "$REPO/md2docx.py" "$SRC"

echo "==> pdf"
soffice --headless --convert-to pdf --outdir "$DIR" "${BASE}.docx" >/dev/null

echo "==> text layer (what an ATS parser sees) -> ${BASE}.txt"
pdftotext "${BASE}.pdf" "${BASE}.txt"
head -6 "${BASE}.txt"

echo "==> page count"
pdfinfo "${BASE}.pdf" | grep -E '^Pages'

echo "==> spelling (unknown words, review by hand)"
hunspell -d en_US -l "$SRC" | sort -u | tr '\n' ' '; echo

# Full-contact build for actual applications (gitignored). PRIVATE_CONTACT holds
# the complete contact line; the public sources carry the scrubbed one.
if [ -f "$REPO/PRIVATE_CONTACT" ]; then
  CONTACT="$(head -1 "$REPO/PRIVATE_CONTACT")"
  if [ -z "$CONTACT" ]; then
    echo "==> private build skipped: PRIVATE_CONTACT is empty"
  else
    echo "==> private build (full contact) -> private/${BASE}.*"
    mkdir -p "$REPO/private"
    PRIV_MD="$REPO/private/${BASE}.md"
    # Substitute through a scratch file. Tailored variants are themselves built
    # from private/<name>.md, and reading and writing one path in the same
    # redirect truncates it to zero bytes before awk ever reads it.
    WORK="$REPO/private/.${BASE}.full.md"
    awk -v repl="$CONTACT" \
      '/^Email: \[/ && !done { print repl "  "; done=1; next } { print }' \
      "$SRC" > "$WORK"
    # Public sources get a full-contact copy alongside them; a source that is
    # already the private one keeps its scrubbed contact line.
    [ "$SRC" = "$PRIV_MD" ] || cp "$WORK" "$PRIV_MD"
    python3 "$REPO/md2docx.py" "$WORK" >/dev/null
    mv "$REPO/private/.${BASE}.full.docx" "$REPO/private/${BASE}.docx"
    soffice --headless --convert-to pdf --outdir "$REPO/private" "$REPO/private/${BASE}.docx" >/dev/null 2>&1
    rm -f "$WORK"
  fi
fi
